{
  "name": "graphward",
  "version": "6.0.0",
  "private": true,
  "description": "Graph-backed codebase intelligence for AI coding agents: real dependency graphs, impact analysis, safety gates, an MCP server, and installable skills/agents/workflows for 9 AI IDEs.",
  "type": "module",
  "homepage": "https://github.com/vinideep/engineering-intelligence#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinideep/engineering-intelligence.git"
  },
  "bugs": {
    "url": "https://github.com/vinideep/engineering-intelligence/issues"
  },
  "bin": {
    "graphward": "./dist/cli/index.js",
    "gw": "./dist/cli/index.js",
    "gw-mcp": "./dist/mcp/cli.js",
    "engineering-intelligence": "./dist/cli/index.js",
    "ei-mcp": "./dist/mcp/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "bench",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:integration": "npm run build && node scripts/run-tests.mjs --integration",
    "test:benchmark": "node scripts/benchmark-runner.mjs",
    "test:provider-smoke": "npm run build && node scripts/provider-smoke.mjs",
    "test:graph": "npm run build && node --test test/graph.test.mjs",
    "test:mcp": "npm run build && node --test test/mcp.test.mjs",
    "prepack": "npm run clean && npm run build",
    "bench": "npm run build && node bench/replay.mjs . --commits 30"
  },
  "keywords": [
    "graphward",
    "codebase-intelligence",
    "dependency-graph",
    "mcp",
    "agent-skills",
    "ai-ide",
    "ai-dlc",
    "agentic-workflows",
    "token-optimization",
    "agile",
    "codex",
    "claude-code",
    "cursor",
    "copilot",
    "gemini",
    "antigravity"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  }
}
